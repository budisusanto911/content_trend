+        response_format: { type: "json_object" },
+        max_tokens: 800
+      });
+      return JSON.parse(response.choices[0]?.message?.content || '{}');
+    } catch (e: any) {
+      console.error(e);
+      return { titleIdeas: ["Error Generating Title"], description: "Error", tags: [] };
+    }
+  }
