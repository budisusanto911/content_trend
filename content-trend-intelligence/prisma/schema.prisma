generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String?
  createdAt       DateTime         @default(now())
  contentLibraries ContentLibrary[]
}

model Platform {
  id     Int      @id @default(autoincrement())
  name   String   @unique
  videos Video[]
}

model Video {
  id           String        @id
  platformId   Int
  platform     Platform      @relation(fields: [platformId], references: [id])
  title        String
  creator      String
  originalUrl  String
  thumbnailUrl String?
  uploadTime   DateTime
  hashtags     Json?
  category     String?
  metrics      VideoMetric[]
  trendScores  TrendScore[]
}

model VideoMetric {
  id         Int      @id @default(autoincrement())
  videoId    String
  video      Video    @relation(fields: [videoId], references: [id])
  views      Int      @default(0)
  likes      Int      @default(0)
  comments   Int      @default(0)
  shares     Int      @default(0)
  recordedAt DateTime @default(now())
}

model TrendScore {
  id             Int      @id @default(autoincrement())
  videoId        String
  video          Video    @relation(fields: [videoId], references: [id])
  score          Float
  viewVelocity   Float
  growthRate     Float
  engagementRate Float
  calculatedAt   DateTime @default(now())
}

model ContentLibrary {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  topic            String
  originalSources  Json
  generatedContext Json
  status           String   @default("Research")
  createdAt        DateTime @default(now())
}

model PublisherProfile {
  id                 String   @id @default(uuid())
  name               String
  targetKeyword      String
  youtubeConnected   Boolean  @default(false)
  tiktokConnected    Boolean  @default(false)
  instagramConnected Boolean  @default(false)
  igUsername         String?
  igPassword         String?
  tiktokCookies      String?
  youtubeToken       String?
  createdAt          DateTime @default(now())
}
